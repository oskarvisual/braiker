NODE_ENV=development
DATABASE_URL="mysql://braiker:change-me@mysql.example.com:3306/braiker"
TRADING_MODE=paper
APP_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
SESSION_SECRET="replace-with-a-long-random-secret"
# Canonical browser origin used for CSRF checks behind a reverse proxy.
# Use the public HTTPS origin in staging/production, with no trailing slash.
APP_ORIGIN="http://localhost:3000"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="change-me-before-first-run"
AI_ENABLED=false
# Optional advisory-only review. It can reject a candidate but can never approve
# risk, change capital limits, or submit an order. Leave AI_ENABLED=false to
# keep the deterministic strategy path fully local.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
# Optional smaller-model override for the read-only Bot Manager chat.
# Empty means it uses OPENAI_MODEL. It never authorizes or performs trading actions.
BOT_MANAGER_CHAT_MODEL=""
OPENAI_TIMEOUT_MS=8000
AI_MAX_ANALYSES_PER_BOT_PER_DAY=10
ALPACA_PAPER_BASE_URL="https://paper-api.alpaca.markets"
ALPACA_API_KEY="paper-key-only"
ALPACA_API_SECRET="paper-secret-only"
ALPACA_DATA_FEED="iex"
LOG_LEVEL=info

# Optional bearer token for Prometheus scraping of /api/metrics. Without it,
# only a signed-in Admin may read metrics.
METRICS_TOKEN=""

# Optional SMTP alerts. Leave SMTP_HOST empty to keep email delivery disabled.
# Delivery occurs only for alert types selected in Settings; credentials stay server-only.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Braiker Alerts <alerts@example.com>"

# Optional Telegram Bot Manager and alert delivery. Keep this server-only.
TELEGRAM_BOT_TOKEN=""

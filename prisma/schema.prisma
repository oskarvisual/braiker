generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum TradingMode {
  PAPER
  LIVE
}

enum BotStatus {
  RUNNING
  PAUSED
  RISK_HALTED
  ERROR
  MAINTENANCE
}

enum BotRunMode {
  OFF
  SIMULATION
  PAPER_ACTIVE
}

enum BotLifeStatus {
  ACTIVE
  DEAD
}

/// The global, non-trading BrAIker manager keeps conversations separate from
/// individual trading bots. Operations is the pinned, alert-backed session.
enum ManagerChatSessionKind {
  OPERATIONS
  CONVERSATION
}

enum ManagerChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ManagerChatMessageSource {
  WEB
  TELEGRAM
  TELEGRAM_ALERT
  SYSTEM
}

/// Individual bot conversations are local to the web application. A Manager
/// note is visible in the recipient's bot-chat history, never in Telegram.
enum BotChatSessionKind {
  CONVERSATION
  MANAGER_NOTE
}

/// Day-scoped context is advisory-only. It can add caution to AI review but
/// can never become an instruction, a signal, or an execution authority.
enum BotDailyContextSource {
  USER_CHAT
  MANAGER_NOTE
}

/// A proposed management change is separate from a conversational reply.
/// Only the small allowlist below may be executed after a human confirmation.
enum ManagerActionKind {
  TURN_ON
  TURN_OFF
}

enum ManagerActionProposalStatus {
  PENDING
  CONFIRMING
  EXECUTED
  EXPIRED
  FAILED
}

enum ResourceCategory {
  MACRO
  NEWS
  FILINGS
  EARNINGS
  SENTIMENT
  ETF_ROTATION
  TECHNICAL
}

enum TradeAction {
  BUY
  SELL
  HOLD
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  NEW
  PARTIALLY_FILLED
  FILLED
  CANCELED
  REJECTED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model User {
  id           String         @id @default(uuid()) @db.Char(36)
  email        String         @unique @db.VarChar(320)
  passwordHash String         @db.VarChar(255)
  role         UserRole       @default(VIEWER)
  mustChangePassword Boolean  @default(true)
  createdAt    DateTime       @default(now()) @db.DateTime(3)
  updatedAt    DateTime       @updatedAt @db.DateTime(3)
  sessions     Session[]
  memberships  WalletMember[]
  auditLogs    AuditLog[]
  telegramManagerSessions TelegramManagerSession[]
  telegramPairingCodes TelegramPairingCode[]
  managerChatSessions ManagerChatSession[]
  botChatSessions BotChatSession[]
  botDailyContexts BotDailyContext[]
  managerActionProposals ManagerActionProposal[]
  resourceSources ResourceSource[]
  learnedInstructions BotLearnedInstruction[]
  macroCalendarEvents MacroCalendarEvent[]
  resolvedLearningProposals BotLearningProposal[] @relation("LearningProposalResolver")
}

/// URL-only curated source registry. Source pages are untrusted input and
/// snapshots retain only bounded text evidence, never files or binaries.
model ResourceSource {
  id              String           @id @default(uuid()) @db.Char(36)
  category        ResourceCategory
  name            String           @db.VarChar(160)
  url             String           @unique @db.VarChar(191)
  hostname        String           @db.VarChar(191)
  active          Boolean          @default(false)
  autoActivated   Boolean          @default(false)
  reviewStatus    String           @default("PENDING") @db.VarChar(24)
  refreshMinutes  Int              @default(1440)
  lastFetchedAt   DateTime?        @db.DateTime(3)
  nextRefreshAt   DateTime?        @db.DateTime(3)
  lastError       String?          @db.VarChar(1000)
  proposedById    String?          @db.Char(36)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
  proposedBy      User?            @relation(fields: [proposedById], references: [id], onDelete: SetNull)
  snapshots       ResourceSnapshot[]
  briefResources  DailyBriefResource[]
  @@index([category, active, nextRefreshAt])
  @@index([reviewStatus, updatedAt])
}

model ResourceSnapshot {
  id           String         @id @default(uuid()) @db.Char(36)
  sourceId     String         @db.Char(36)
  canonicalUrl String         @db.VarChar(191)
  title        String         @db.VarChar(500)
  contentHash  String         @db.Char(64)
  excerpt      String         @db.Text
  summary      String?        @db.Text
  relevance    String         @default("PENDING") @db.VarChar(24)
  fetchedAt    DateTime       @db.DateTime(3)
  createdAt    DateTime       @default(now()) @db.DateTime(3)
  source       ResourceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  briefs       DailyBriefResource[]
  @@index([sourceId, fetchedAt])
  @@index([contentHash])
}

/// Immutable pre-market context assembled from reviewed public resources.
model DailyMarketBrief {
  id          String               @id @default(uuid()) @db.Char(36)
  marketDate  DateTime             @unique @db.Date
  status      String               @default("GENERATED") @db.VarChar(24)
  content     Json
  generatedAt DateTime             @default(now()) @db.DateTime(3)
  resources   DailyBriefResource[]
  botInputs   DailyBotInput[]
}

model DailyBriefResource {
  briefId    String           @db.Char(36)
  sourceId   String           @db.Char(36)
  snapshotId String           @db.Char(36)
  brief      DailyMarketBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  source     ResourceSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  snapshot   ResourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  @@id([briefId, sourceId, snapshotId])
  @@index([sourceId])
  @@index([snapshotId])
}

/// Immutable, per-bot interpretation of the daily briefing. Its deterministic
/// recommendations may only add caution or defer a candidate.
model DailyBotInput {
  id                 String           @id @default(uuid()) @db.Char(36)
  botId              String           @db.Char(36)
  dailyMarketBriefId String           @db.Char(36)
  marketDate         DateTime         @db.Date
  content            Json
  createdAt          DateTime         @default(now()) @db.DateTime(3)
  bot                BotInstance      @relation(fields: [botId], references: [id], onDelete: Cascade)
  dailyMarketBrief   DailyMarketBrief @relation(fields: [dailyMarketBriefId], references: [id], onDelete: Cascade)
  @@unique([botId, marketDate])
  @@index([dailyMarketBriefId])
}

/// Official or Admin-reviewed macro releases. The guard consumes only the
/// explicit timestamp and impact classification, never page instructions.
model MacroCalendarEvent {
  id              String   @id @default(uuid()) @db.Char(36)
  provider        String   @db.VarChar(80)
  externalId      String?  @db.VarChar(191)
  title           String   @db.VarChar(255)
  impact          String   @default("HIGH") @db.VarChar(16)
  startsAt        DateTime @db.DateTime(3)
  sourceUrl       String   @db.VarChar(191)
  sourceReference String?  @db.VarChar(191)
  createdById     String?  @db.Char(36)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  @@unique([provider, title, startsAt])
  @@index([impact, startsAt])
  @@index([externalId])
  @@index([createdById, createdAt])
}

/// One global, persistent macro protection window. The worker defaults to
/// 10/15 until this row exists, so migrations never weaken the guard.
model MacroGuardSettings {
  scope         String   @id @default("global") @db.VarChar(24)
  beforeMinutes Int      @default(10)
  afterMinutes  Int      @default(15)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)
}

model LoginThrottle {
  keyHash        String    @id @db.Char(64)
  failures       Int       @default(0)
  windowStartedAt DateTime @default(now()) @db.DateTime(3)
  blockedUntil   DateTime? @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)
  @@index([blockedUntil])
}

model Session {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Wallet {
  id          String         @id @default(uuid()) @db.Char(36)
  name        String         @db.VarChar(120)
  currency    String         @default("USD") @db.Char(3)
  managedCapital Decimal     @default(100) @db.Decimal(28, 12)
  unallocatedCapital Decimal @default(100) @db.Decimal(28, 12)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
  members     WalletMember[]
  connections BrokerConnection[]
  bots        BotInstance[]
  auditLogs   AuditLog[]
  positions   Position[]
  portfolioSnapshots PortfolioSnapshot[]
  brokerOrderSnapshots BrokerOrderSnapshot[]
}

model WalletMember {
  walletId String   @db.Char(36)
  userId   String   @db.Char(36)
  role     UserRole
  createdAt DateTime @default(now()) @db.DateTime(3)
  wallet   Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([walletId, userId])
  @@index([userId])
}

model BrokerConnection {
  id              String      @id @default(uuid()) @db.Char(36)
  walletId        String      @db.Char(36)
  provider        String      @db.VarChar(40)
  mode            TradingMode @default(PAPER)
  encryptedKey    String      @db.Text
  keyIv           String      @db.VarChar(64)
  keyTag          String      @db.VarChar(64)
  encryptedSecret String      @db.Text
  secretIv        String      @db.VarChar(64)
  secretTag       String      @db.VarChar(64)
  keyVersion      Int         @default(1)
  createdAt       DateTime    @default(now()) @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @db.DateTime(3)
  wallet          Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@unique([walletId, provider, mode])
}

model BotInstance {
  id             String    @id @default(uuid()) @db.Char(36)
  walletId       String    @db.Char(36)
  name           String    @db.VarChar(120)
  templateId     String    @default("NAVIGATOR") @db.VarChar(24)
  avatarSeed     String    @default("compass") @db.VarChar(32)
  runMode        BotRunMode @default(OFF)
  lifeStatus     BotLifeStatus @default(ACTIVE)
  initialCapital Decimal   @default(0) @db.Decimal(28, 12)
  currentCapital Decimal   @default(0) @db.Decimal(28, 12)
  reservedCapital Decimal  @default(0) @db.Decimal(28, 12)
  diedAt         DateTime? @db.DateTime(3)
  status         BotStatus @default(PAUSED)
  killSwitch     Boolean   @default(true)
  riskPolicy     Json
  strategyProfile Json
  aiProfile      Json?
  cloneSourceId  String?   @db.Char(36)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)
  wallet         Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  stateChanges   BotStateTransition[]
  modeChanges    BotModeTransition[]
  memories       BotMemoryEntry[]
  capitalEvents  BotCapitalEvent[]
  proposals      TradeProposal[]
  watchlist      Watchlist[]
  botPositions   BotPosition[]
  portfolioSnapshots PortfolioSnapshot[]
  scanRuns       BotScanRun[]
  managerActionProposals ManagerActionProposal[]
  botChatSessions BotChatSession[]
  dailyInputs    DailyBotInput[]
  dailyContexts  BotDailyContext[]
  learnedInstructions BotLearnedInstruction[]
  learningProposals BotLearningProposal[]
  @@index([walletId, status])
  @@index([cloneSourceId])
}

/// Internal, additive learning. The visible strategy instruction always
/// prevails and inactive revisions remain as audit history.
model BotLearnedInstruction {
  id            String      @id @default(uuid()) @db.Char(36)
  botId         String      @db.Char(36)
  createdById   String?     @db.Char(36)
  source        String      @db.VarChar(24)
  content       String      @db.VarChar(1200)
  revision      Int
  active        Boolean     @default(true)
  deactivatedAt DateTime?   @db.DateTime(3)
  createdAt     DateTime    @default(now()) @db.DateTime(3)
  bot           BotInstance @relation(fields: [botId], references: [id], onDelete: Cascade)
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  @@unique([botId, revision])
  @@index([botId, active, createdAt])
  @@index([createdById, createdAt])
}

/// A bot may suggest a bounded caution rule after deterministic evidence, but
/// it can never activate the rule without an Admin resolution.
model BotLearningProposal {
  id           String      @id @default(uuid()) @db.Char(36)
  botId        String      @db.Char(36)
  dedupeKey    String      @unique @db.VarChar(191)
  rule         String      @db.VarChar(1200)
  evidence     Json
  status       String      @default("PENDING") @db.VarChar(24)
  delivery     String      @db.VarChar(24)
  expiresAt    DateTime    @db.DateTime(3)
  resolvedById String?     @db.Char(36)
  resolvedAt   DateTime?   @db.DateTime(3)
  createdAt    DateTime    @default(now()) @db.DateTime(3)
  updatedAt    DateTime    @updatedAt @db.DateTime(3)
  bot          BotInstance @relation(fields: [botId], references: [id], onDelete: Cascade)
  resolvedBy   User?       @relation("LearningProposalResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  @@index([botId, status, expiresAt])
  @@index([resolvedById, createdAt])
}

model BotCapitalEvent {
  id           String      @id @default(uuid()) @db.Char(36)
  botId        String      @db.Char(36)
  kind         String      @db.VarChar(32)
  amount       Decimal     @db.Decimal(28, 12)
  balanceAfter Decimal     @db.Decimal(28, 12)
  metadata     Json?
  createdAt    DateTime    @default(now()) @db.DateTime(3)
  bot          BotInstance @relation(fields: [botId], references: [id], onDelete: Cascade)
  @@index([botId, createdAt])
}

model BotModeTransition {
  id        String     @id @default(uuid()) @db.Char(36)
  botId     String     @db.Char(36)
  fromMode  BotRunMode?
  toMode    BotRunMode
  reason    String     @db.VarChar(255)
  createdAt DateTime   @default(now()) @db.DateTime(3)
  bot       BotInstance @relation(fields: [botId], references: [id], onDelete: Cascade)
  @@index([botId, createdAt])
}

model BotMemoryEntry {
  id        String      @id @default(uuid()) @db.Char(36)
  botId     String      @db.Char(36)
  kind      String      @db.VarChar(32)
  content   Json
  createdAt DateTime    @default(now()) @db.DateTime(3)
  bot       BotInstance @relation(fields: [botId], references: [id], onDelete: Cascade)
  @@index([botId, kind, createdAt])
}

model BotStateTransition {
  id        String    @id @default(uuid()) @db.Char(36)
  botId     String    @db.Char(36)
  fromState BotStatus?
  toState   BotStatus
  reason    String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  bot       BotInstance @relation(fields: [botId], references: [id], onDelete: Cascade)
  @@index([botId, createdAt])
}

model Watchlist {
  id        String   @id @default(uuid()) @db.Char(36)
  botId     String   @db.Char(36)
  symbol    String   @db.VarChar(16)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  bot       BotInstance @relation(fields: [botId], references: [id], onDelete: Cascade)
  @@unique([botId, symbol])
  @@index([symbol, enabled])
}

/// Server-synchronized Alpaca master list. `enabled` is the Admin's global
/// universe gate; it is deliberately separate from each bot's watchlist.
model TradableAsset {
  id        String   @id @default(uuid()) @db.Char(36)
  symbol    String   @unique @db.VarChar(16)
  name      String   @db.VarChar(255)
  exchange  String   @db.VarChar(32)
  assetClass String  @db.VarChar(32)
  active    Boolean  @default(true)
  tradable  Boolean  @default(true)
  enabled   Boolean  @default(false)
  syncedAt  DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@index([enabled, active, tradable])
  @@index([symbol, enabled])
}

model MarketBar {
  id        String   @id @default(uuid()) @db.Char(36)
  symbol    String   @db.VarChar(16)
  timeframe String   @db.VarChar(16)
  timestamp DateTime @db.DateTime(3)
  open      Decimal  @db.Decimal(28, 12)
  high      Decimal  @db.Decimal(28, 12)
  low       Decimal  @db.Decimal(28, 12)
  close     Decimal  @db.Decimal(28, 12)
  volume    Decimal  @db.Decimal(28, 12)
  tradeCount Int?
  vwap      Decimal? @db.Decimal(28, 12)
  feed      String   @db.VarChar(24)
  receivedAt DateTime @default(now()) @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@unique([symbol, timeframe, timestamp, feed])
  @@index([symbol, timeframe, timestamp])
}

model MarketEvaluation {
  id              String   @id @default(uuid()) @db.Char(36)
  evaluationKey   String   @unique @db.VarChar(220)
  botId           String   @db.Char(36)
  symbol          String   @db.VarChar(16)
  timeframe       String   @db.VarChar(16)
  candleTimestamp DateTime @db.DateTime(3)
  status          String   @default("CREATED") @db.VarChar(32)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  completedAt     DateTime? @db.DateTime(3)
  @@index([botId, symbol, candleTimestamp])
}

model BotScanRun {
  id          String   @id @default(uuid()) @db.Char(36)
  botId       String   @db.Char(36)
  status      String   @db.VarChar(16)
  reason      String   @db.VarChar(32)
  message     String   @db.VarChar(500)
  outcomes    Json
  startedAt   DateTime @default(now()) @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)
  bot         BotInstance @relation(fields: [botId], references: [id], onDelete: Cascade)
  @@index([botId, startedAt])
  @@index([startedAt])
}

model MarketSnapshot {
  id        String   @id @default(uuid()) @db.Char(36)
  botId     String   @db.Char(36)
  symbol    String   @db.VarChar(16)
  payload   Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([botId, symbol, createdAt])
}

model MarketStreamEvent {
  id        String   @id @default(uuid()) @db.Char(36)
  symbol    String?  @db.VarChar(16)
  eventType String   @db.VarChar(48)
  provider  String   @db.VarChar(40)
  payload   Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([symbol, createdAt])
}

model StrategySignal {
  id        String      @id @default(uuid()) @db.Char(36)
  botId     String      @db.Char(36)
  snapshotId String?    @db.Char(36)
  symbol    String      @db.VarChar(16)
  action    TradeAction
  confidence Int
  reason    String      @db.Text
  payload   Json
  createdAt DateTime    @default(now()) @db.DateTime(3)
  @@index([botId, symbol, createdAt])
}

model AiDecision {
  id        String   @id @default(uuid()) @db.Char(36)
  botId     String   @db.Char(36)
  provider  String   @db.VarChar(40)
  model     String   @db.VarChar(120)
  request   Json
  response  Json?
  inputTokens Int?
  outputTokens Int?
  costUsd   Decimal? @db.Decimal(28, 12)
  error     String?  @db.Text
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([botId, createdAt])
}

model TradeProposal {
  id          String      @id @default(uuid()) @db.Char(36)
  botId       String      @db.Char(36)
  signalId    String?     @db.Char(36)
  aiDecisionId String?    @db.Char(36)
  symbol      String      @db.VarChar(16)
  action      TradeAction
  orderType   OrderType
  quantity    Decimal     @db.Decimal(28, 12)
  limitPrice  Decimal?    @db.Decimal(28, 12)
  estimatedPrice Decimal  @db.Decimal(28, 12)
  reservationAmount Decimal @default(0) @db.Decimal(28, 12)
  status      String      @default("PENDING_RISK") @db.VarChar(32)
  context     Json
  createdAt   DateTime    @default(now()) @db.DateTime(3)
  bot         BotInstance @relation(fields: [botId], references: [id], onDelete: Cascade)
  riskDecision RiskDecision?
  executionJob ExecutionJob?
  @@index([botId, symbol, createdAt])
}

model RiskDecision {
  id          String        @id @default(uuid()) @db.Char(36)
  proposalId  String        @unique @db.Char(36)
  approved    Boolean
  reason      String        @db.VarChar(80)
  checks      Json
  approvedOrder Json?
  createdAt   DateTime      @default(now()) @db.DateTime(3)
  proposal    TradeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model ExecutionJob {
  id              String      @id @default(uuid()) @db.Char(36)
  proposalId      String      @unique @db.Char(36)
  status          JobStatus   @default(PENDING)
  attempts        Int         @default(0)
  leaseToken      String?     @db.Char(36)
  leaseExpiresAt  DateTime?   @db.DateTime(3)
  lastError       String?     @db.Text
  createdAt       DateTime    @default(now()) @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @db.DateTime(3)
  proposal        TradeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([status, leaseExpiresAt])
}

model Order {
  id            String      @id @default(uuid()) @db.Char(36)
  proposalId    String      @db.Char(36)
  brokerOrderId String?     @unique @db.VarChar(128)
  clientOrderId String      @unique @db.VarChar(128)
  symbol        String      @db.VarChar(16)
  action        TradeAction
  orderType     OrderType
  quantity      Decimal     @db.Decimal(28, 12)
  limitPrice    Decimal?    @db.Decimal(28, 12)
  status        OrderStatus @default(PENDING)
  rawPayload    Json?
  reservationReleasedAt DateTime? @db.DateTime(3)
  createdAt     DateTime    @default(now()) @db.DateTime(3)
  updatedAt     DateTime    @updatedAt @db.DateTime(3)
  fills         Fill[]
  @@index([proposalId, createdAt])
}

model BotPosition {
  id                String      @id @default(uuid()) @db.Char(36)
  botId             String      @db.Char(36)
  symbol            String      @db.VarChar(16)
  quantity          Decimal     @db.Decimal(28, 12)
  averageEntryPrice Decimal     @db.Decimal(28, 12)
  updatedAt         DateTime    @updatedAt @db.DateTime(3)
  bot               BotInstance @relation(fields: [botId], references: [id], onDelete: Cascade)
  @@unique([botId, symbol])
  @@index([botId, updatedAt])
}

model Fill {
  id            String   @id @default(uuid()) @db.Char(36)
  orderId       String   @db.Char(36)
  botId         String   @db.Char(36)
  brokerFillId  String   @unique @db.VarChar(128)
  quantity      Decimal  @db.Decimal(28, 12)
  price         Decimal  @db.Decimal(28, 12)
  realizedPnl   Decimal  @default(0) @db.Decimal(28, 12)
  filledAt      DateTime @db.DateTime(3)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, filledAt])
  @@index([botId, filledAt])
}

model Position {
  id                String   @id @default(uuid()) @db.Char(36)
  walletId          String   @db.Char(36)
  symbol            String   @db.VarChar(16)
  quantity          Decimal  @db.Decimal(28, 12)
  averageEntryPrice Decimal  @db.Decimal(28, 12)
  marketValue       Decimal  @db.Decimal(28, 12)
  unrealizedPnl     Decimal  @db.Decimal(28, 12)
  updatedAt         DateTime @updatedAt @db.DateTime(3)
  wallet            Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@unique([walletId, symbol])
  @@index([walletId, updatedAt])
}

model BrokerOrderSnapshot {
  id              String   @id @default(uuid()) @db.Char(36)
  walletId        String   @db.Char(36)
  brokerOrderId   String   @unique @db.VarChar(128)
  clientOrderId   String?  @db.VarChar(128)
  symbol          String   @db.VarChar(16)
  side            String   @db.VarChar(8)
  orderType       String   @db.VarChar(16)
  status          String   @db.VarChar(32)
  quantity        Decimal  @db.Decimal(28, 12)
  filledQuantity  Decimal  @default(0) @db.Decimal(28, 12)
  filledAveragePrice Decimal? @db.Decimal(28, 12)
  submittedAt     DateTime @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)
  rawPayload      Json
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@index([walletId, submittedAt])
  @@index([walletId, status])
}

model PortfolioSnapshot {
  id            String   @id @default(uuid()) @db.Char(36)
  walletId      String   @db.Char(36)
  botId         String?  @db.Char(36)
  equity        Decimal  @db.Decimal(28, 12)
  cash          Decimal  @db.Decimal(28, 12)
  exposure      Decimal  @db.Decimal(28, 12)
  realizedPnl   Decimal  @db.Decimal(28, 12)
  unrealizedPnl Decimal  @db.Decimal(28, 12)
  capturedAt    DateTime @db.DateTime(3)
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bot           BotInstance? @relation(fields: [botId], references: [id], onDelete: SetNull)
  @@index([walletId, capturedAt])
}

model DailyPerformance {
  id        String   @id @default(uuid()) @db.Char(36)
  walletId  String   @db.Char(36)
  day       DateTime @db.Date
  startingEquity Decimal @db.Decimal(28, 12)
  endingEquity   Decimal @db.Decimal(28, 12)
  realizedPnl    Decimal @db.Decimal(28, 12)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@unique([walletId, day])
}

model ReconciliationRun {
  id             String   @id @default(uuid()) @db.Char(36)
  walletId       String   @db.Char(36)
  status         String   @db.VarChar(32)
  discrepancy    Json?
  startedAt      DateTime @default(now()) @db.DateTime(3)
  completedAt    DateTime? @db.DateTime(3)
  @@index([walletId, startedAt])
}

model ScheduledTask {
  id            String   @id @default(uuid()) @db.Char(36)
  name          String   @unique @db.VarChar(120)
  cronExpression String  @db.VarChar(120)
  timezone      String   @default("America/New_York") @db.VarChar(64)
  enabled       Boolean  @default(true)
  nextRunAt     DateTime? @db.DateTime(3)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)
  runs          JobRun[]
}

model JobRun {
  id             String      @id @default(uuid()) @db.Char(36)
  taskId         String      @db.Char(36)
  scheduledFor   DateTime    @db.DateTime(3)
  status         JobStatus   @default(PENDING)
  attempts       Int         @default(0)
  leaseToken     String?     @db.Char(36)
  leaseExpiresAt DateTime?   @db.DateTime(3)
  startedAt      DateTime?   @db.DateTime(3)
  completedAt    DateTime?   @db.DateTime(3)
  error          String?     @db.Text
  task           ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([taskId, scheduledFor])
  @@index([status, leaseExpiresAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @db.Char(36)
  walletId  String?  @db.Char(36)
  action    String   @db.VarChar(120)
  target    String   @db.VarChar(120)
  metadata  Json?
  createdAt DateTime @default(now()) @db.DateTime(3)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  wallet    Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)
  @@index([walletId, createdAt])
}

model SystemEvent {
  id        String   @id @default(uuid()) @db.Char(36)
  severity  String   @db.VarChar(16)
  source    String   @db.VarChar(64)
  message   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([severity, createdAt])
}

model ErrorEvent {
  id        String   @id @default(uuid()) @db.Char(36)
  source    String   @db.VarChar(64)
  message   String   @db.Text
  stack     String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([source, createdAt])
}

model NotificationSettings {
  id                  String   @id @default(uuid()) @db.Char(36)
  scope               String   @unique @default("global") @db.VarChar(32)
  webhookEnabled      Boolean  @default(false)
  encryptedWebhookUrl String?  @db.Text
  webhookUrlIv        String?  @db.VarChar(64)
  webhookUrlTag       String?  @db.VarChar(64)
  webhookKeyVersion   Int      @default(1)
  webhookEvents       Json
  emailEnabled        Boolean  @default(false)
  emailRecipients     Json
  emailEvents         Json
  telegramManagerEnabled Boolean @default(false)
  telegramEnabled     Boolean  @default(false)
  telegramEvents      Json
  telegramReceiveMessages Boolean @default(false)
  createdAt           DateTime @default(now()) @db.DateTime(3)
  updatedAt           DateTime @updatedAt @db.DateTime(3)
}

/// Durable, de-duplicated operational alerts. Delivery timestamps make retries
/// recoverable without repeatedly notifying while an outage remains open.
model NotificationAlert {
  id                     String   @id @default(uuid()) @db.Char(36)
  dedupeKey              String   @unique @db.VarChar(191)
  eventType              String   @db.VarChar(64)
  severity               String   @db.VarChar(16)
  subject                String   @db.VarChar(255)
  message                String   @db.Text
  metadata               Json?
  status                 String   @default("OPEN") @db.VarChar(16)
  firstObservedAt        DateTime @db.DateTime(3)
  lastObservedAt         DateTime @db.DateTime(3)
  resolvedAt             DateTime? @db.DateTime(3)
  webhookDeliveredAt     DateTime? @db.DateTime(3)
  webhookLastAttemptAt   DateTime? @db.DateTime(3)
  webhookLastError       String?  @db.VarChar(1000)
  emailDeliveredAt       DateTime? @db.DateTime(3)
  emailLastAttemptAt     DateTime? @db.DateTime(3)
  emailLastError         String?  @db.VarChar(1000)
  telegramDeliveredAt    DateTime? @db.DateTime(3)
  telegramLastAttemptAt  DateTime? @db.DateTime(3)
  telegramLastError      String?  @db.VarChar(1000)
  createdAt              DateTime @default(now()) @db.DateTime(3)
  updatedAt              DateTime @updatedAt @db.DateTime(3)
  @@index([status, lastObservedAt])
  @@index([eventType, status])
}

/// The globally paired, read-only Telegram conversation for the Bot Manager.
/// The chat identifier is never returned through browser APIs or logs.
model TelegramManagerSession {
  scope          String   @id @default("global") @db.VarChar(32)
  telegramChatId String   @unique @db.VarChar(64)
  userId         String   @db.Char(36)
  linkedAt       DateTime @default(now()) @db.DateTime(3)
  lastReceivedAt DateTime? @db.DateTime(3)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       TelegramManagerMessage[]
  @@index([userId])
}

/// One-time pairing credentials are hashed at rest and expire quickly.
model TelegramPairingCode {
  id         String   @id @default(uuid()) @db.Char(36)
  codeHash   String   @unique @db.Char(64)
  userId     String   @db.Char(36)
  expiresAt  DateTime @db.DateTime(3)
  consumedAt DateTime? @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

/// Stores only the next Telegram update offset, making worker restarts idempotent.
model TelegramRuntimeState {
  scope        String   @id @default("global") @db.VarChar(32)
  nextUpdateId String?  @db.VarChar(64)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)
}

/// Read-only, user-owned conversation sessions for the global Bot Manager.
/// They have no execution authority and never contain credentials.
model ManagerChatSession {
  id          String                  @id @default(uuid()) @db.Char(36)
  userId      String                  @db.Char(36)
  kind        ManagerChatSessionKind
  title       String                  @db.VarChar(120)
  pinned      Boolean                 @default(false)
  externalKey String?                 @unique @db.VarChar(191)
  createdAt   DateTime                @default(now()) @db.DateTime(3)
  updatedAt   DateTime                @updatedAt @db.DateTime(3)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ManagerChatMessage[]
  @@index([userId, pinned, updatedAt])
}

/// Message transcript for the global Bot Manager. `sourceReference` makes
/// alert/retry delivery idempotent without storing a Telegram secret.
model ManagerChatMessage {
  id              String                   @id @default(uuid()) @db.Char(36)
  sessionId       String                   @db.Char(36)
  sourceReference String?                  @unique @db.VarChar(191)
  role            ManagerChatMessageRole
  source          ManagerChatMessageSource
  content         String                   @db.Text
  metadata        Json?
  createdAt       DateTime                 @default(now()) @db.DateTime(3)
  session         ManagerChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}

/// A durable, single-use action proposal. The confirmation code is hashed at
/// rest; execution always re-enters the ordinary locked bot-control service.
model ManagerActionProposal {
  id              String                      @id @default(uuid()) @db.Char(36)
  userId          String                      @db.Char(36)
  botId           String                      @db.Char(36)
  action          ManagerActionKind
  status          ManagerActionProposalStatus @default(PENDING)
  codeHash        String                      @db.Char(64)
  requestedVia    String                      @db.VarChar(24)
  expiresAt       DateTime                    @db.DateTime(3)
  confirmedAt     DateTime?                   @db.DateTime(3)
  executedAt      DateTime?                   @db.DateTime(3)
  failureReason   String?                     @db.VarChar(120)
  createdAt       DateTime                    @default(now()) @db.DateTime(3)
  updatedAt       DateTime                    @updatedAt @db.DateTime(3)
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot             BotInstance                 @relation(fields: [botId], references: [id], onDelete: Cascade)
  @@index([userId, status, expiresAt])
  @@index([botId, createdAt])
}

/// Private, local explanation sessions. They are never delivered to Telegram
/// and cannot mutate the bot or create an order.
model BotChatSession {
  id        String             @id @default(uuid()) @db.Char(36)
  userId    String             @db.Char(36)
  botId     String             @db.Char(36)
  kind      BotChatSessionKind @default(CONVERSATION)
  title     String             @default("New conversation") @db.VarChar(120)
  createdAt DateTime           @default(now()) @db.DateTime(3)
  updatedAt DateTime           @updatedAt @db.DateTime(3)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot       BotInstance        @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages  BotChatMessage[]
  @@index([userId, updatedAt])
  @@index([botId, userId, updatedAt])
}

model BotChatMessage {
  id        String                 @id @default(uuid()) @db.Char(36)
  sessionId String                 @db.Char(36)
  role      ManagerChatMessageRole
  content   String                 @db.Text
  createdAt DateTime               @default(now()) @db.DateTime(3)
  session   BotChatSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dailyContext BotDailyContext?
  @@index([sessionId, createdAt])
}

/// An auditable, bounded message selected for the current NY market day.
/// This is intentionally separate from the immutable resource briefing.
model BotDailyContext {
  id        String                @id @default(uuid()) @db.Char(36)
  botId     String                @db.Char(36)
  userId    String                @db.Char(36)
  messageId String                @unique @db.Char(36)
  marketDate DateTime             @db.Date
  source    BotDailyContextSource
  content   String                @db.Text
  createdAt DateTime              @default(now()) @db.DateTime(3)
  bot       BotInstance           @relation(fields: [botId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   BotChatMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@index([botId, marketDate])
  @@index([userId, marketDate])
}

/// Read-only Bot Manager conversation history; pairing secrets are redacted.
model TelegramManagerMessage {
  id               String   @id @default(uuid()) @db.Char(36)
  sessionScope     String   @db.VarChar(32)
  telegramUpdateId String?  @unique @db.VarChar(64)
  direction        String   @db.VarChar(16)
  content          String   @db.VarChar(4000)
  createdAt        DateTime @default(now()) @db.DateTime(3)
  session          TelegramManagerSession @relation(fields: [sessionScope], references: [scope], onDelete: Cascade)
  @@index([sessionScope, createdAt])
}

/// Persistent provider circuit breaker. The OpenAI advisory is disabled only
/// after an actual quota/billing rejection, and can be reopened only after a
/// successful explicit availability check. It never affects deterministic risk.
model AiRuntimeState {
  scope          String   @id @default("global") @db.VarChar(32)
  status         String   @default("ACTIVE") @db.VarChar(32)
  disabledAt     DateTime? @db.DateTime(3)
  lastCheckedAt  DateTime? @db.DateTime(3)
  lastError      String?  @db.VarChar(128)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)
}

/// Shared liveness state written by the worker and read by the web process.
/// This must remain durable because App Platform components do not share /tmp.
model WorkerRuntimeState {
  scope       String   @id @default("global") @db.VarChar(32)
  instanceId  String   @db.VarChar(128)
  startedAt   DateTime @db.DateTime(3)
  heartbeatAt DateTime @db.DateTime(3)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
}

/// Administrator-managed defaults for the three editable limits of each bot
/// personality. Existing bots retain their own saved policy until edited.
model BotProfileDefault {
  templateId String   @id @db.VarChar(24)
  riskPolicy Json
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)
}

/// App-level allocation envelope for the single Alpaca Paper account.
/// Wallets are virtual portfolios; this row is never a second broker account.
model PaperCapitalPool {
  scope              String   @id @default("global") @db.VarChar(32)
  managedCapital     Decimal  @default(100) @db.Decimal(28, 12)
  unallocatedCapital Decimal  @default(100) @db.Decimal(28, 12)
  createdAt          DateTime @default(now()) @db.DateTime(3)
  updatedAt          DateTime @updatedAt @db.DateTime(3)
}

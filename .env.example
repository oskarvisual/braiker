NODE_ENV=development
DATABASE_URL="mysql://braiker:change-me@mysql.example.com:3306/braiker"
TRADING_MODE=paper
APP_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
SESSION_SECRET="replace-with-a-long-random-secret"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="change-me-before-first-run"
AI_ENABLED=false
ALPACA_PAPER_BASE_URL="https://paper-api.alpaca.markets"
ALPACA_API_KEY="paper-key-only"
ALPACA_API_SECRET="paper-secret-only"
ALPACA_DATA_FEED="iex"
LOG_LEVEL=info

# Optional bearer token for Prometheus scraping of /api/metrics. Without it,
# only a signed-in Admin may read metrics.
METRICS_TOKEN=""

# Optional SMTP alerts. Leave SMTP_HOST empty to keep email delivery disabled.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Braiker Alerts <alerts@example.com>"

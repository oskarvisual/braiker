{
  "name": "braiker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx src/worker/main.ts",
    "build": "next build",
    "build:worker": "tsup src/worker/main.ts --format esm --target node20 --out-dir dist --clean",
    "start": "next start",
    "start:worker": "tsx src/worker/main.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "paper:soak:check": "node scripts/paper-soak-check.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "2.4.3",
    "next": "16.3.1",
    "node-cron": "4.2.1",
    "pino": "9.9.4",
    "prom-client": "15.1.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.15.32",
    "@types/bcryptjs": "2.4.6",
    "@types/node-cron": "3.0.11",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "prisma": "6.16.2",
    "tsx": "4.20.3",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
